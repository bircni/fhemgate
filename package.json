{
  "name": "homebridge-fhem2hb",
  "displayName": "FHEM",
  "version": "0.6.0-alpha.0",
  "private": true,
  "description": "a fhem platform plugin for homebridge, maintained successor of homebridge-fhem",
  "author": {
    "name": "bircni"
  },
  "contributors": [
    {
      "name": "justme1968"
    }
  ],
  "license": "ISC",
  "keywords": [
    "homebridge-plugin",
    "homebridge",
    "fhem"
  ],
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist",
    "config.schema.json",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.build.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "pack-smoke": "node scripts/pack-smoke.ts",
    "verify": "bun install --frozen-lockfile && bun run lint && bun run typecheck && bun run coverage && bun run build && bun run pack-smoke",
    "prepublishOnly": "bun run verify"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || ^26.0.0",
    "homebridge": "^1.8.0 || ^2.0.0"
  },
  "packageManager": "bun@1.4.4",
  "repository": {
    "type": "git",
    "url": "https://github.com/bircni/fhem2hb.git"
  },
  "dependencies": {
    "postman-request": "^2.88.1-postman.31"
  },
  "optionalDependencies": {
    "fakegato-history": ">=0.5.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@homebridge/hap-nodejs": "2.3.0",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "homebridge": "^2.5.0",
    "typescript": "^6",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
