{
  "name": "homebridge-fhem2hb",
  "displayName": "FHEM",
  "version": "0.6.0-alpha.0",
  "private": true,
  "description": "a fhem platform plugin for homebridge, maintained successor of homebridge-fhem",
  "keywords": [
    "fhem",
    "homebridge",
    "homebridge-plugin"
  ],
  "license": "ISC",
  "author": {
    "name": "bircni"
  },
  "contributors": [
    {
      "name": "justme1968"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/bircni/fhem2hb.git"
  },
  "files": [
    "dist",
    "config.schema.json",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --type-aware --deny-warnings --report-unused-disable-directives",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.build.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "bun run build && vitest run --config vitest.e2e.config.ts",
    "coverage": "vitest run --coverage",
    "pack-smoke": "node scripts/pack-smoke.ts",
    "verify": "bun install --frozen-lockfile && bun run format:check && bun run lint && bun run typecheck && bun run coverage && bun run build && bun run pack-smoke && vitest run --config vitest.e2e.config.ts",
    "prepublishOnly": "bun run verify"
  },
  "devDependencies": {
    "@homebridge/hap-nodejs": "2.3.0",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "homebridge": "^2.5.0",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2007",
    "typescript": "^7",
    "vitest": "^5.1.1"
  },
  "optionalDependencies": {
    "fakegato-history": ">=0.5.3"
  },
  "engines": {
    "homebridge": "^1.8.0 || ^2.0.0",
    "node": "^22.12.0 || ^24.0.0 || ^26.0.0"
  },
  "packageManager": "bun@1.4.4"
}
